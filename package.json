{
  "name": "safe-space",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "npx expo start --tunnel",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "build:web": "npx expo export -p web",
    "build:android": "npx expo prebuild -p android",
    "lint": "eslint . --cache",
    "lint:cache": "eslint . --cache --cache-location .eslintcache",
    "lint:clean": "rm -rf node_modules/.cache/eslint .eslintcache && npm run lint",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.0",
    "@supabase/supabase-js": "^2.89.0",
    "date-fns": "^2.30.0",
    "expo": "~54.0.30",
    "expo-constants": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linear-gradient": "~14.0.2",
    "expo-router": "~4.0.22",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "typescript": "~5.3.3"
  }
}
