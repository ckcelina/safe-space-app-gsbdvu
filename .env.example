
# ============================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# APP CONFIGURATION
# ============================================
# App scheme for deep linking (used for OAuth redirects)
EXPO_PUBLIC_APP_SCHEME=natively

# App name (used for storage keys)
EXPO_PUBLIC_APP_NAME=Natively

# ============================================
# WIDGET CONFIGURATION (iOS only)
# ============================================
# iOS App Group ID for widget data sharing
# Must match the App Group ID in your Apple Developer account
EXPO_PUBLIC_WIDGET_GROUP_ID=group.com.anonymous.Natively

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Disable Expo telemetry
EXPO_NO_TELEMETRY=1

# Disable tunnel mode (prevents ngrok prompts)
EXPO_NO_TUNNEL=1

# Enable edit mode for development (optional)
# EXPO_PUBLIC_ENABLE_EDIT_MODE=FALSE

# ============================================
# BACKEND CONFIGURATION (Optional)
# ============================================
# Only needed if using a custom backend API
# EXPO_PUBLIC_BACKEND_URL=https://your-backend-url.com
