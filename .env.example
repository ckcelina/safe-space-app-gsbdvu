# Safe Space App - Environment Variables
# Copy this file to .env.local and fill in your actual values

# ═══════════════════════════════════════════════════════════════════
# SUPABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════
# Get these from: Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ═══════════════════════════════════════════════════════════════════
# SENTRY ERROR TRACKING (Optional)
# ═══════════════════════════════════════════════════════════════════
# Get this from: Sentry.io > Project Settings > Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ═══════════════════════════════════════════════════════════════════
# DEVELOPMENT SETTINGS
# ═══════════════════════════════════════════════════════════════════
# Set to 'true' to enable dev mode features
EXPO_PUBLIC_DEV_MODE=false

# ═══════════════════════════════════════════════════════════════════
# NOTES:
# ═══════════════════════════════════════════════════════════════════
# - Variables prefixed with EXPO_PUBLIC_ are available in the app
# - Never commit .env.local to git (it's in .gitignore)
# - Restart the Expo dev server after changing these values
