
# Supabase Configuration (Required)
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: 
# 1. Create a .env file with your actual values (copy this file and rename to .env)
# 2. The EXPO_PUBLIC_ prefix makes these available in the app at runtime
# 3. Never commit your .env file to version control
# 4. For Expo Go, these values are also read from app.json "extra" section as fallback
